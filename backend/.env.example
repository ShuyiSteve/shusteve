# shuSteve backend environment variables (copy to .env for local development)

# Server
PORT=8080
GIN_MODE=debug

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shusteve
DB_PASSWORD=shusteve_password
DB_NAME=shusteve

# Auth
# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string
TOKEN_TTL_HOURS=72

# Initial admin account (created on first boot only)
ADMIN_EMAIL=admin@shusteve.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Cookies & CORS
# Set to true only when serving over HTTPS in production
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# Seed placeholder content on first boot (disable for a clean start)
SEED_DATA=true
