# Root environment file used by docker-compose.yml (copy to .env)

# MySQL
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3307
DB_NAME=shusteve
DB_USER=shusteve
DB_PASSWORD=shusteve_password

# Backend
BACKEND_PORT=8080
JWT_SECRET=replace_with_a_long_random_string
ADMIN_EMAIL=admin@shusteve.com
ADMIN_PASSWORD=change_me_to_a_strong_password

# Frontend
FRONTEND_PORT=3000
VITE_GITHUB_URL=https://github.com/your-username
VITE_EMAIL=you@example.com
